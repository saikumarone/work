SELECT datname database_name,
pid process_id,
usename username,
state state,
wait_event_type wait_event_type,
wait_event wait_event,
now() - pg_stat_activity.query_start running_time,
application_name app_name,
query_start query_start_time,
regexp_replace(query, E'[\\n\\r]+', ' ', 'g' ) query
FROM pg_stat_activity
WHERE 1 = 1
AND TRUNC( EXTRACT(EPOCH FROM (now() - query_start)) / 60 ) >= :alert_level
AND pid <> pg_backend_pid()
AND state ='active'
AND query NOT LIKE '%VACUUM%'
AND query NOT LIKE 'START_REPLICATION SLOT%'
ORDER BY 1,2

