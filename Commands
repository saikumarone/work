  concat_ws(
    '.',
    s.nspname::text,
    coalesce(rel.relname::text, '?'),
    con.contype::text,
    con.conname::text
  ) AS check_cons
FROM pg_constraint con
JOIN relevant_schemas s ON s.namespace_oid = con.connamespace
LEFT JOIN pg_class rel ON rel.oid = con.conrelid
WHERE con.contype = 'c'
ORDER BY 1;


